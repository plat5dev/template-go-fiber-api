project_id: my-app

# Path mode until managed images ship. Accepts monorepo root, product root, or compose dir.
plat5_compose: /path/to/plat5
# auth_compose: /path/to/plat5

auth:
  enabled: false

admin_token: dev-admin-token

# Credential brand (identity). Unset → plat5. Keys {brand}-k-2-, sessions {brand}-s-2-
# apikey_brand: plat5

upstreams:
  api: 3000

routes:
  - ./routes.identity.yml
  - ./routes.audit.yml
  - ./routes.yml

# What plat5 init writes for this starter (versions are the latest tags at the time).
project_id: my-app

versions:
  plat5: v0.7.1
  auth: v0.2.2
  operator: v0.4.1

modules:
  auth: true
  operator: true
  observability: true

app:
  compose: ./docker-compose.yml
  web: "http://localhost:3001"               # customer-console/
  operator_console: "http://localhost:5412"  # operator-console/

upstreams:
  api: "3000"

routes:
  - ./routes.identity.yml
  - ./routes.audit.yml
  - ./routes.yml

roles: ./roles.yml

operator:
  routes: ./operator.routes.yml              # with this starter's routes.operator.yml in it

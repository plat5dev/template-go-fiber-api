# What plat5 init writes for this starter (versions are the latest tags at the time).
project_id: my-app

versions:
  plat5: v0.7.0
  auth: v0.2.0
  operator: v0.4.0
  operator_console: v0.1.0

modules:
  auth: true
  operator: true
  observability: true

app:
  compose: ./docker-compose.yml
  web: http://localhost:3001

upstreams:
  api: "3000"

routes:
  - ./routes.identity.yml
  - ./routes.audit.yml
  - ./routes.yml

roles: ./roles.yml

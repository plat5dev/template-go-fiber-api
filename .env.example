PORT=3000
INTERNAL_PORT=3001
DATABASE_PATH=./data/app.db

# Identity's internal base URL (for lifecycle cleanup and assignee access evaluation).
# Set automatically in docker-compose.yml. When unset, lifecycle polling is skipped and
# setting an assignee returns 503.
# IDENTITY_INTERNAL_URL=http://identity:3001

# OpenTelemetry (standard OTEL_* variables are handled by the OTel SDK).
# /metrics on INTERNAL_PORT and JSON stdout logs are always enabled.
OTEL_SERVICE_NAME=api
OTEL_RESOURCE_ATTRIBUTES=service.namespace=api,deployment.environment=development
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=prometheus  # push traces only; scrape /metrics
# OTEL_SDK_DISABLED=true

PORT=3000
INTERNAL_PORT=3001
DATABASE_PATH=./data/app.db
# Identity's internal base URL, for its lifecycle log and the assignee check.
# Unset: the log isn't read, and a task with an assignee is a 503.
# The compose file sets it; identity's internal port isn't published to your machine.
# IDENTITY_INTERNAL_URL=http://identity:3001
# Required. The permission a task's assignee needs on its project: the one
# services/api.yml requires to read an environment's tasks. A deployment that
# renames it sets this too; otherwise the check fails closed and refuses every
# assignee.
TASK_ASSIGNEE_PERMISSION=project:read
OTEL_SERVICE_NAME=api
OTEL_SERVICE_NAMESPACE=api
# Overrides service.version: the build's VERSION, dev without one.
# OTEL_SERVICE_VERSION=
# OTEL_SERVICE_INSTANCE_ID=
DEPLOYMENT_ENV=development
# OTLP destination: when set, traces and metrics are both pushed (http/protobuf).
# /metrics scrape is always on INTERNAL_PORT regardless of OTLP.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=prometheus  # push traces only; scrape metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_TRACES_SAMPLER_RATIO=1
# OTEL_SDK_DISABLED=true
